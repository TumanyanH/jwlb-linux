# Copy to server.env (same folder as docker-compose.yml) and fill in. Keep it private: chmod 600 server.env
# BIND and DB_PATH are set by docker-compose.yml; do not set them here.

# Email for the confirmation / password-reset codes. Leave SMTP_HOST empty to print codes to the log instead.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Study Library <no-reply@example.org>

# Google sign-in (optional). Leave empty to switch it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
