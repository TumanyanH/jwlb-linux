#!/bin/sh
# C compiler / linker for builds on machines without gcc: uses Zig (installed in ~/.cargo/bin).
ZIG="$(command -v zig 2>/dev/null || echo "$HOME/.cargo/bin/zig")"
set -- "$@" _END_
for a do
  shift
  case "$a" in
    _END_) ;;
    --target=*|-Wl,--no-undefined-version|-Wl,-znostart-stop-gc|-Wl,-z,nostart-stop-gc) ;;
    *) set -- "$@" "$a" ;;
  esac
done
exec "$ZIG" cc -target x86_64-linux-gnu.2.17 "$@"
